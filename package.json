{
    "name": "@signalsafe/tree-spec-editor-theme-bootstrap",
    "version": "0.3.8",
    "type": "module",
    "description": "Bootstrap-token theme for @signalsafe/tree-spec-editor semantic classes.",
    "license": "MIT",
    "sideEffects": [
        "*.css",
        "**/*.css"
    ],
    "exports": {
        "./styles.css": "./styles.css"
    },
    "files": [
        "styles.css",
        "src/**/*.css",
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
        "RELEASING.md",
        "docs/README.md",
        "docs/current-release-candidate.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "smoke:package": "node scripts/smoke-package.mjs",
        "publish:dry-run": "npm pack --dry-run",
        "test": "node --test tests/*.test.mjs",
        "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='scripts/*.mjs' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tests/*.test.mjs"
    },
    "keywords": [
        "tree-spec",
        "graph-editor",
        "theme",
        "css",
        "bootstrap",
        "signalsafe"
    ]
}
